# Copy to .env and fill in. Shell environment variables take precedence over this file.

# Twitch application credentials, used to get an IGDB token.
# https://api-docs.igdb.com/#account-creation
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Notion integration token. Share both databases below with this integration.
# https://www.notion.so/my-integrations
NOTION_TOKEN=

# Notion database listing what to import. Its pages need a URL property, called "URL", pointing to
# an IGDB game (https://www.igdb.com/games/...) or a Steam app (https://store.steampowered.com/app/...).
SOURCE_DB_ID=

# Notion page that holds the generated databases.
MAIN_PAGE_ID=

# Title of the main games database, the one you browse and annotate.
MAIN_GAMES_DB_NAME=

# Uncomment for debug logs from ultimate-notion, the Notion client library.
# ULTIMATE_NOTION_DEBUG=true
