{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":configMigration"
  ],
  "timezone": "America/Sao_Paulo",
  "schedule": [
    // Before 8am every Monday.
    "* 0-7 * * 1"
  ],
  "minimumReleaseAge": "1 day",
  "prHourlyLimit": 5,
  // Automatically merge updates if CI build status is passing.
  "automerge": true,
  "automergeStrategy": "squash",
  // The pep621 and pre-commit managers are not enabled by default.
  // github-actions is enabled by default and listed here for explicitness.
  "enabledManagers": [
    "github-actions",
    "pep621",
    "pre-commit"
  ],
  // pre-commit support is currently in beta and requires explicit opt-in.
  "pre-commit": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchDepNames": [
        // Don't suggest upgrades for the project's required Python version.
        "python"
      ],
      "enabled": false
    },
    {
      // Don't suggest upgrades for the pre-commit repos themselves. That's done
      // by sync-with-uv in the workflow. Renovate's pre-commit manager should
      // only offer upgrades for packages in additional_dependencies fields.
      "matchManagers": [
        "pre-commit"
      ],
      "matchDepTypes": [
        "repository"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "pre-commit"
      ],
      "addLabels": [
        "pre-commit"
      ]
    },
    {
      "matchManagers": [
        "pep621"
      ],
      "addLabels": [
        "pep621"
      ]
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "addLabels": [
        "github-actions"
      ]
    },
    {
      "matchPackageNames": ["pydantic"],
      "allowedVersions": "<2.13",
      "description": "Until https://github.com/ultimate-notion/ultimate-notion/issues/189 is fixed"
    },
    {
      // Group pep621 and pre-commit updates into a single PR so the pre-commit
      // additional_dependencies and pyproject.toml deps land together.
      "matchManagers": [
        "pep621",
        "pre-commit"
      ],
      "groupName": "pep621 and pre-commit",
      "groupSlug": "pep621-pre-commit",
      // Bump the range even if the new version satisfies the existing range.
      "rangeStrategy": "bump",
      // Don't update uv.lock as an artifact. That's done by
      // the uv-lock-upgrade pre-commit hook in the workflow.
      "skipArtifactsUpdate": true
    }
  ]
}
