{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":configMigration"
  ],
  "timezone": "America/Sao_Paulo",
  "schedule": [
    // Before 8am every Monday.
    "* 0-7 * * 1"
  ],
  "minimumReleaseAge": "1 day",
  // Automatically merge updates if CI build status is passing.
  "automerge": true,
  "automergeStrategy": "squash",
  // The pep621 and pre-commit managers are not enabled by default.
  // github-actions is enabled by default and listed here for explicitness.
  "enabledManagers": [
    "github-actions",
    "pep621",
    "pre-commit"
  ],
  // pre-commit support is currently in beta and requires explicit opt-in.
  "pre-commit": {
    "enabled": true
  },
  "packageRules": [
    {
      // Don't suggest upgrades on Python version
      "matchManagers": [
        "pep621"
      ],
      "matchDepNames": [
        "python"
      ],
      "enabled": false
    },
    {
      // pep621 would normally run `uv lock` to update uv.lock as an artifact alongside pyproject.toml changes.
      // We disable that here because uv-lock-upgrade runs as a pre-commit hook in the workflow instead.
      "matchManagers": [
        "pep621"
      ],
      "addLabels": [
        "pep621"
      ],
      "skipArtifactsUpdate": true
    },
    {
      "matchManagers": [
        "pre-commit"
      ],
      "addLabels": [
        "pre-commit"
      ]
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "addLabels": [
        "github-actions"
      ]
    },
    {
      "matchPackageNames": ["pydantic"],
      "allowedVersions": "<2.13",
      "description": "Until https://github.com/ultimate-notion/ultimate-notion/issues/189 is fixed"
    },
    {
      // Group pep621 and pre-commit updates into a single PR so the
      // pre-commit hook revs and pyproject.toml deps land together.
      "matchManagers": [
        "pep621",
        "pre-commit"
      ],
      "constraintsFiltering": "strict",
      "groupName": "pep621 and pre-commit",
      "groupSlug": "pep621-pre-commit",
      "rangeStrategy": "bump"
    }
  ]
}
