{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],

  "timezone": "America/Sao_Paulo",
  "schedule": ["before 6am on monday"],

  // The pep621 and pre-commit managers are not enabled by default.
  // github-actions is enabled by default and listed here for explicitness.
  "enabledManagers": ["github-actions", "pre-commit", "pep621"],

  // pre-commit support is currently in beta and requires explicit opt-in.
  "pre-commit": {
    "enabled": true
  },

  // Prevent Renovate from rebasing or closing PRs that the workflow has
  // modified with pre-commit hook output.
  "rebaseWhen": "never",

  "packageRules": [
    {
      // pep621 would normally run `uv lock` to update uv.lock as an artifact
      // alongside pyproject.toml changes. We disable that here because
      // uv-lock-upgrade runs as a pre-commit hook in the workflow instead.
      "matchManagers": ["pep621"],
      "addLabels": ["pep621"],
      "skipArtifactsUpdate": true
    },
    {
      "matchManagers": ["pre-commit"],
      "addLabels": ["pre-commit"]
    },
    {
      "matchManagers": ["github-actions"],
      "addLabels": ["github-actions"]
    },
    {
      // Group pep621 and pre-commit updates into a single PR so the
      // pre-commit hook revs and pyproject.toml deps land together.
      "matchManagers": ["pep621", "pre-commit"],
      "groupName": "pep621 and pre-commit",
      "groupSlug": "pep621-pre-commit"
    }
  ]
}
